# =============================================================================
# NZAMY — PRODUCTION env for the VPS  (generated 2026-07-06)
# =============================================================================
# HOW TO USE على الـ VPS:
#   1) انسخ محتوى هذا الملف إلى:  /www/wwwroot/nzamy/latest-nzamy-full/.env.local
#      (Next.js يقرأ .env.local في وضع الإنتاج مع `next start`)
#   2) chmod 600 .env.local        # صلاحيات محكمة — الملف فيه مفتاح خطير
#   3) npm run build && pm2 reload nzamy
#
# ⚠️ لا ترفع هذا الملف إلى git إطلاقاً (SUPABASE_SERVICE_ROLE_KEY = مفتاح جذر).
#    هذا الملف (.env.vps) مُتجاهَل في .gitignore عبر النمط `.env.*`.
# =============================================================================

# ── 1) SUPABASE ────────────────────────────────────────────────────────────
# نفس مشروع Supabase المستخدم في التطوير (مشروع واحد).
NEXT_PUBLIC_SUPABASE_URL=https://gdqfqfcxnwrwgaphtfhu.supabase.co
# بعض الأكواد الخادمية تقرأ SUPABASE_URL (بدون NEXT_PUBLIC) — نضبطها لنفس القيمة.
SUPABASE_URL=https://gdqfqfcxnwrwgaphtfhu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdkcWZxZmN4bndyd2dhcGh0Zmh1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1MTI2MDksImV4cCI6MjA5NjA4ODYwOX0.DDqdiMhy4jR6uSv0ZnhUdGhjOPJ6mo6uP1rRbskKYog
# مفتاح خدمي — خادم فقط، يتجاوز RLS. لا يُسرّب ولا يُرفع لـ git إطلاقاً.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdkcWZxZmN4bndyd2dhcGh0Zmh1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDUxMjYwOSwiZXhwIjoyMDk2MDg4NjA5fQ.FFn8bqFVUAQa5UGnshxt2pKDjlBRC29YAcEpq1OXsRM

# ── 2) BACKEND MODE  [CRITICAL] ─────────────────────────────────────────────
# يجب أن تكون "supabase" بالضبط، وإلا يسقط التطبيق إلى وضع الديمو (تجاوز مصادقة)
# و instrumentation.ts يوقف الإقلاع في الإنتاج.
NEXT_PUBLIC_NZAMY_WORKFLOW_BACKEND=supabase

# ── 3) APP ──────────────────────────────────────────────────────────────────
# ⚠️ تأكّد أن هذا نطاقك الفعلي (يُستخدم للروابط المطلقة/الرسائل). عدّله إن لزم.
NEXT_PUBLIC_APP_URL=https://nezamy.sa
NEXT_PUBLIC_APP_ENV=production
# 0 = الإنتاج (لا محتوى ديمو للمكتبة؛ حالة فارغة أمينة)
NEXT_PUBLIC_LIB_DEMO_FALLBACK=0

# ── 4) n8n  (دفع التطبيق ← n8n) ─────────────────────────────────────────────
# هذا هو ما يجعل التطبيق يرسل الأحداث لـ n8n (طلب/إسناد/إكمال).
N8N_WEBHOOK_BASE_URL=https://n8n.asra3.com/webhook
# اختياري: سرّ مشترك يُرسَل كترويسة X-Webhook-Secret. إن ضبطته هنا فعّل التحقق
# منه في n8n أيضاً. اتركه فارغاً الآن إن لم تُعدّه في n8n.
N8N_WEBHOOK_SECRET=

# اختياري — مسارات أدوات AI الحيّة (فعّلها فقط إن كانت workflows موجودة في n8n؛
# بدونها ترجع الميزتان "قريباً"):
# N8N_LIBRARY_CHAT_WEBHOOK_URL=https://n8n.asra3.com/webhook/library-chat
# N8N_EXPLAIN_WEBHOOK_URL=https://n8n.asra3.com/webhook/explain-article

# ── ملاحظات / Notes ─────────────────────────────────────────────────────────
# • Evolution API و مفاتيح LLM لا تُوضع هنا — تعيش داخل n8n نفسه.
# • بوابة الدفع مُعطّلة عبر platform_settings.payments_gateway (لوحة الإدارة)،
#   لا عبر متغيّرات بيئة.
# • NODE_ENV و NEXT_RUNTIME يضبطهما Next تلقائياً — لا تضِفهما.
