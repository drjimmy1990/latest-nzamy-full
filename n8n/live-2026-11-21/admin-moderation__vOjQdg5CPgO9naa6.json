  {
   "id": "wf52_compose",
   "name": "5.2 Compose alert",
   "parameters": {
    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  return { json: {\n    branch: '5.2_security_alert', notify: 'admin',\n    subject_ar: 'تنبيه أمني: محاولات دخول فاشلة',\n    body_ar: 'رُصدت محاولات دخول فاشلة. البريد: ' + (p.email || 'غير معروف') + '، المحاولات: ' + (p.attempts || '؟') + '، IP: ' + (p.ip || 'غير معروف') + '.',\n    _payload: p\n  }};\n});"
   },
   "position": [
    540,
