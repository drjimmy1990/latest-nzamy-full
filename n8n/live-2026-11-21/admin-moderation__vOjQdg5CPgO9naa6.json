  {
   "id": "wf53_moderate",
   "name": "5.3 Moderate (keyword)",
   "parameters": {
    "jsCode": "const banned = ['spam','احتيال','نصب','خداع','إعلان ممنوع'];\nreturn $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const content = (p.content || p.text || (p.data && p.data.content) || '').toString().toLowerCase();\n  const hits = banned.filter(b => content.includes(b));\n  return { json: {\n    branch: '5.3_moderation', notify: 'admin',\n    post_id: p.id || p.post_id || null,\n    flagged: hits.length > 0, matched: hits,\n    subject_ar: hits.length ? 'محتوى يحتاج مراجعة' : 'محتوى جديد (سليم)',\n    body_ar: hits.length ? ('تم وسم منشور لاحتوائه على: ' + hits.join('، ')) : 'منشور جديد اجتاز الفحص الآلي.',\n    _todo: 'For nuanced moderation add an LLM node; this is a keyword pre-filter.',\n    _payload: p\n  }};\n});"
   },
