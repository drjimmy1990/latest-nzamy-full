  {
   "id": "wf51_compose",
   "name": "5.1 Compose digest",
   "parameters": {
    "jsCode": "const rows = $input.all().map(i => i.json);\nconst byStatus = {};\nfor (const r of rows) { const s = r.status || 'unknown'; byStatus[s] = (byStatus[s]||0)+1; }\nconst lines = Object.keys(byStatus).map(s => '• ' + s + ': ' + byStatus[s]).join('\\n');\nreturn [{ json: {\n  branch: '5.1_daily_digest', notify: 'admin',\n  subject_ar: 'ملخص نظامي اليومي',\n  body_ar: 'إجمالي الطلبات (آخر ' + rows.length + '):\\n' + lines,\n  counts: byStatus\n}}];"
   },
   "position": [
    820,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
  {
   "id": "wf51_deliver",
   "name": "5.1 Deliver DUMMY",
   "parameters": {
