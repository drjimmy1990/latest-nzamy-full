  {
   "id": "wf24_compose",
   "name": "2.4 Compose escalation",
   "parameters": {
    "jsCode": "// keep only requests older than 48h\nconst cutoff = Date.now() - 48*60*60*1000;\nconst stale = $input.all().filter(it => {\n  const c = it.json.created_at;\n  return c && new Date(c).getTime() < cutoff;\n});\nreturn stale.map(it => {\n  const r = it.json;\n  return { json: {\n    branch: '2.4_sla_escalation', notify: 'admin',\n    entity_id: r.id,\n    subject_ar: 'تنبيه SLA: طلب لم يُسنَد خلال 48 ساعة',\n    body_ar: 'الطلب \"' + (r.title || r.id) + '\" ما زال بانتظار الإسناد منذ أكثر من 48 ساعة. يرجى المتابعة.',\n    created_at: r.created_at\n  }};\n});"
   },
