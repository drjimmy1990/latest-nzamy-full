  {
   "id": "wf21_compose",
   "name": "2.1 Compose new",
   "parameters": {
    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const d = p.data || {};\n  return { json: {\n    branch: '2.1_new_request', notify: 'assignee_or_queue',\n    to_user_id: (p.recipient && p.recipient.id) || d.assignedTo || null,\n    to_role: (p.recipient && p.recipient.role) || d.receiver || null,\n    subject_ar: 'طلب خدمة جديد بانتظار الإسناد',\n    body_ar: ('وصل طلب خدمة جديد: \"' + (d.title || 'بدون عنوان') + '\".\\n' + (d.description || '')).trim(),\n    entity_id: (p.entity && p.entity.id) || null, _payload: p\n  }};\n});"
   },
   "position": [
    520,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
  {
   "id": "wf21_deliver",
   "name": "2.1 Deliver DUMMY",
   "parameters": {
    "method": "POST",
    "url": "https://REPLACE-WITH-EVOLUTION-OR-EMAIL.example/send",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {}
   },
   "position": [
    860,
    0
   ],
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "onError": "continueRegularOutput"
  },
  {
   "id": "wf22_compose",
   "name": "2.2 Compose assigned",
   "parameters": {
    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const d = p.data || {};\n  return { json: {\n    branch: '2.2_assigned', notify: 'client',\n    to_user_id: d.requesterUserId || (p.recipient && p.recipient.id) || null,\n    subject_ar: 'تم إسناد طلبك إلى محامٍ',\n    body_ar: 'تم إسناد طلبك \"' + (d.title || '') + '\" إلى محامٍ من نظامي، وسيتواصل معك قريباً.',\n    entity_id: (p.entity && p.entity.id) || null, _payload: p\n  }};\n});"
   },
   "position": [
    520,
    220
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
