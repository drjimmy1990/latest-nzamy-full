    "authentication": "headerAuth",
    "responseMode": "responseNode",
    "options": {}
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "T8LjmjhlZf6mNVeC",
     "name": "NZAMY AI · inbound"
    }
   }
  },
  {
   "id": "w2",
   "name": "Use model?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    220,
    300
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.body.input.use_model === true }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "w3",
   "name": "Echo",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    460,
    420
   ],
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body;\nreturn [{ json: { run_id: b.run_id, status: 'succeeded', output: { echo: String(b.input?.text ?? '') }, citations: [], usage: { model: null, input_tokens: 0, output_tokens: 0 }, error: null } }];"
   }
  },
  {
   "id": "w4",
   "name": "Build prompt",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    460,
    200
   ],
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body;\n// Wave 0 connectivity test, moved from the retired Anthropic key to the Gemini model every tool uses (owner test 29 Oct: model_error 401).\n// long_answer: the timing probe asks for a consult-sized answer.\nconst long = b.input?.long_answer === true;\nconst sources = (b.sources || []).map(s => `<source sid=\"${s.sid}\">${s.title ?? ''} ${s.number ?? ''}\\n${s.text ?? ''}</source>`).join('\\n');\nconst system = long\n  ? 'أنت مساعد قانوني سعودي على منصة نظامي. أجب عن سؤال المستخدم بالعربية الفصحى في نحو ٤٠٠ كلمة اعتماداً على المصادر فقط.'\n  : 'You are a connectivity test for the Nzamy platform. Reply with the user text exactly, nothing else.';\nconst text = String(b.input?.text ?? '').slice(0, 4000);\nreturn [{ json: { system, content: long ? `<sources>\\n${sources}\\n</sources>\\n\\n${text}` : text } }];"
   }
  },
  {
   "id": "w5",
   "name": "Write",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 3,
   "position": [
    700,
    200
   ],
   "onError": "continueErrorOutput",
   "parameters": {
    "promptType": "define",
    "text": "={{ $json.content }}",
    "options": {
     "systemMessage": "={{ $json.system }}"
    }
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "PJV8iDPVPFc8zhg9",
     "name": "NZAMY Anthropic (x-api-key)"
    }
   }
  },
  {
   "id": "w9",
   "name": "Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
   "typeVersion": 1,
   "position": [
    700,
    420
   ],
   "parameters": {
    "modelName": "models/gemini-3.1-flash-lite",
    "options": {
     "maxOutputTokens": 3000,
     "temperature": 0
    }
   },
   "credentials": {
    "googlePalmApi": {
     "id": "5p0YKMLaCVAAMklV",
     "name": "Google Gemini(PaLM) Api account"
    }
   }
  },
  {
   "id": "w6",
   "name": "Parse result",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    940,
    140
   ],
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body;\nconst t = String(typeof $json.output === 'string' ? $json.output : ($json.text ?? '')).trim();\nif (!t) return [{ json: { run_id: b.run_id, status: 'failed', output: null, citations: [], usage: null, error: { code: 'schema_invalid', message: 'the model returned no text' } } }];\nreturn [{ json: { run_id: b.run_id, status: 'succeeded', output: { echo: t }, citations: [], usage: { model: 'gemini-3.1-flash-lite', input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 }, error: null } }];"
   }
  },
  {
   "id": "w7",
   "name": "Model error",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    940,
    300
   ],
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body;\nconst e = $json.error;\nconst msg = String((typeof e === 'string' ? e : e?.message) ?? $json.message ?? 'model call failed').slice(0, 300);\nreturn [{ json: { run_id: b.run_id, status: 'failed', output: null, citations: [], usage: null, error: { code: 'model_error', message: msg } } }];"
   }
  },
  {
   "id": "w8",
   "name": "Respond",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.5,
   "position": [
    1180,
    300
   ],
   "parameters": {
    "respondWith": "firstIncomingItem",
    "options": {
     "responseCode": 200
    }
   }
  }
 ],
