   ],
   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body;\n// Wave 0 connectivity test, moved from the retired Anthropic key to the Gemini model every tool uses (owner test 29 Oct: model_error 401).\nreturn [{ json: { system: 'You are a connectivity test for the Nzamy platform. Reply with the user text exactly, nothing else.', content: String(b.input?.text ?? '').slice(0, 2000) } }];"
