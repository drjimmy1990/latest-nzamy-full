   "parameters": {
    "jsCode": "const b = $('Webhook').first().json.body;\nconst t = String(typeof $json.output === 'string' ? $json.output : ($json.text ?? '')).trim();\nif (!t) return [{ json: { run_id: b.run_id, status: 'failed', output: null, citations: [], usage: null, error: { code: 'schema_invalid', message: 'the model returned no text' } } }];\nreturn [{ json: { run_id: b.run_id, status: 'succeeded', output: { echo: t }, citations: [], usage: { model: 'gemini-3.1-flash-lite', input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 }, error: null } }];"
