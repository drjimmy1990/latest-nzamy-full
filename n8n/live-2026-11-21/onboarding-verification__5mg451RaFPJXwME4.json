       "id": "tok",
       "leftValue": "={{ $json.query.token }}",
       "rightValue": "CHANGE-ME-APPROVAL-SECRET",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ]
    },
    "options": {}
