   "id": "wf12a_compose",
   "name": "1.2a Compose notify admin",
   "parameters": {
    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const name = p.display_name || p.name || (p.data && p.data.display_name) || 'محامٍ جديد';\n  return { json: {\n    branch: '1.2a_notify_admin_new_lawyer', notify: 'admin',\n    lawyer_user_id: p.user_id || p.id || null,\n    subject_ar: 'طلب توثيق محامٍ جديد',\n    body_ar: 'قدّم المحامي ' + name + ' طلب توثيق حساب. يرجى المراجعة والاعتماد من لوحة الإدارة.',\n    _payload: p\n  }};\n});"
