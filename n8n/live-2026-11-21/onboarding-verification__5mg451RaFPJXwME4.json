   "id": "wf11_compose",
   "name": "1.1 Compose welcome",
   "parameters": {
    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const name = p.display_name || p.name || (p.data && p.data.display_name) || 'عميلنا العزيز';\n  return { json: {\n    branch: '1.1_welcome', notify: 'new_user',\n    to_user_id: p.id || p.user_id || null,\n    to_email: p.email || null, to_phone: p.phone || null,\n    role: p.user_type || p.role || null,\n    subject_ar: 'مرحباً بك في نظامي',\n    body_ar: 'أهلاً ' + name + '! سعداء بانضمامك إلى منصة نظامي القانونية. يمكنك الآن طلب استشارة أو خدمة قانونية بسهولة.',\n    _payload: p\n  }};\n});"
   },
   "position": [
    540,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
