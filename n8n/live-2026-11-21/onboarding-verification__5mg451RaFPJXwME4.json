    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const name = p.display_name || p.name || (p.data && p.data.name) || 'مكتب محاماة';\n  return { json: {\n    branch: '1.3_firm_onboarding', notify: 'new_firm',\n    to_user_id: p.user_id || p.id || null,\n    subject_ar: 'مرحباً بمكتبكم في نظامي',\n    body_ar: 'أهلاً بمكتب ' + name + ' في منصة نظامي. (ميزة المكاتب ضمن مرحلة لاحقة.)',\n    _post_beta: true, _payload: p\n  }};\n});"
