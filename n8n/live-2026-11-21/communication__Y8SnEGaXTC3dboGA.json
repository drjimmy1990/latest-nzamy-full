  },
  {
   "id": "wf42_filter",
   "name": "4.2 Filter 24h",
   "parameters": {
    "jsCode": "const now = Date.now();\nconst in24h = now + 24*60*60*1000;\nconst due = $input.all().filter(it => {\n  const s = it.json.scheduled_at;\n  if (!s) return false;\n  const t = new Date(s).getTime();\n  return t > now && t <= in24h;\n});\nreturn due.map(it => {\n  const c = it.json;\n  return { json: {\n    consultation_id: c.id,\n    to_user_id: c.requester_user_id,\n    scheduled_at: c.scheduled_at,\n    subject_ar: 'تذكير: لديك استشارة قريباً',\n    body_ar: 'نذكّرك باستشارتك المجدولة بتاريخ ' + c.scheduled_at + '. نتمنّى لك موعداً موفقاً.'\n  }};\n});"
   },
   "position": [
    800,
    260
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
  {
   "id": "wf42_resolve",
