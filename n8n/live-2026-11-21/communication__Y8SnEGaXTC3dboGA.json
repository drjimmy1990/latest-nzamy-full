  {
   "id": "wf41_triage",
   "name": "4.1 Triage (keyword)",
   "parameters": {
    "jsCode": "return $input.all().map(item => {\n  const p = (item.json.body ?? item.json) || {};\n  const text = (p.message || p.text || (p.data && p.data.message) || '').toString();\n  const rules = [\n    { id: 'labor', kw: ['عمل','راتب','فصل','موظف','نهاية خدمة'] },\n    { id: 'rent', kw: ['إيجار','عقار','مستأجر','مؤجر','شقة'] },\n    { id: 'family', kw: ['طلاق','حضانة','نفقة','زواج','ميراث'] },\n    { id: 'criminal', kw: ['جنائي','جريمة','حكم','عقوبة','نيابة'] },\n    { id: 'commercial', kw: ['شركة','تجاري','عقد','بيع','شراء'] }\n  ];\n  let intent = 'other';\n  for (const r of rules) { if (r.kw.some(k => text.includes(k))) { intent = r.id; break; } }\n  return { json: {\n    branch: '4.1_whatsapp_triage', channel: 'whatsapp',\n    from: p.from || p.phone || (p.data && p.data.from) || null,\n    intent,\n    reply_ar: 'شكراً لتواصلك مع نظامي. صُنّف طلبك ضمن: ' + intent + '. سيتواصل معك فريقنا قريباً.',\n    _todo: 'For richer intent add an LLM node; this is a deterministic keyword fallback. Reply via Evolution API.',\n    _payload: p\n  }};\n});"
   },
   "position": [
    540,
    0
   ],
   "type": "n8n-nodes-base.code",
   "typeVersion": 2
  },
  {
   "id": "wf41_deliver",
