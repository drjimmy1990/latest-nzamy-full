        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{$env.EMAIL_FROM_NAME}} <{{$env.EMAIL_FROM}}>\",\n  \"to\": \"{{$json.client_email}}\",\n  \"subject\": \"شاركنا تجربتك\",\n  \"html\": \"<p>مرحباً {{$json.client_name}}،</p><p>نود معرفة تجربتك مع منصة نظامي. شاركنا رأيك لنعمل على تحسين خدماتنا.</p>\"\n}",
        "options": {}
      },
