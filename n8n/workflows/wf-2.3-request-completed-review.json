    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.service_requests WHERE id = $1;",
        "options": { "queryParameters": "={{[$json.body.entity.id]}}" }
      },
      "id": "44444444-4444-4444-8444-444444444403",
      "name": "Fetch Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "44444444-4444-4444-8444-444444444404",
              "leftValue": "={{$json.status}}",
              "rightValue": "completed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444405",
      "name": "If Status Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sr.id AS request_id, sr.title, p.email AS client_email, p.phone AS client_phone, p.full_name AS client_name FROM public.service_requests sr JOIN public.profiles p ON sr.requester_user_id = p.id WHERE sr.id = $1;",
        "options": { "queryParameters": "={{[$json.id]}}" }
      },
      "id": "44444444-4444-4444-8444-444444444406",
      "name": "Fetch Client",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{$env.RESEND_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{$env.EMAIL_FROM_NAME}} <{{$env.EMAIL_FROM}}>\",\n  \"to\": \"{{$json.client_email}}\",\n  \"subject\": \"تم إكمال طلبك القانوني\",\n  \"html\": \"<p>مرحباً {{$json.client_name}}،</p><p>تم إكمال طلبك القانوني رقم ({{$json.request_id}}) بعنوان: {{$json.title}}. شكراً لاستخدامك منصة نظامي.</p>\"\n}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444407",
      "name": "Email Completion Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, -100]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.notifications (user_id, type, title, body) VALUES ($1, 'request_completed', 'تم إكمال الطلب', 'تم إكمال طلبك القانوني');",
        "options": { "queryParameters": "={{[$(Fetch Request).requester_user_id]}}" }
      },
      "id": "44444444-4444-4444-8444-444444444408",
      "name": "Insert Notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, -100]
    },
