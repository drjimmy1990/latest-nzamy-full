# ─── Dependencies ──────────────────────────────────────
node_modules/
/.pnp
.pnp.js

# ─── Next.js ───────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts

# ─── Environment Variables (NEVER commit) ─────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ─── Logs ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Testing ──────────────────────────────────────────
/coverage

# ─── TypeScript ────────────────────────────────────────
*.tsbuildinfo

# ─── OS Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── IDE / Editor ─────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ─── Security / Keys ──────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx

# ─── Supabase ─────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ─── Vercel ───────────────────────────────────────────
.vercel

# ─── GitNexus (code intelligence index) ───────────────
.gitnexus/

# ─── Misc ─────────────────────────────────────────────
*.tgz
.cache/
.turbo/

# ─── Blog content (owner drops into blog-toolkit/blog_final/; not shipped in git) ──
blog_final/
blog-toolkit/blog_final*/
blog-toolkit/_blog-seed-rejects.log

# ─── Test / source content (owner data — too large for git) ───────────────
test/

# ─── Library toolkit parsed output (regenerated via `npm run library:parse`) ──
library-toolkit/output/

# ─── Library source files (owner data — too large for git) ────────────────
library_last/
last_owner/
blog-toolkit/_articles-backup-*.json

# Playwright MCP scratch output (console logs, snapshots) from browser verification runs.
.playwright-mcp/
