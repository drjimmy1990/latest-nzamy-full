{
  "name": "nzamy-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/smoke-routes.mjs",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "blog:backup": "node blog-toolkit/blog-backup.mjs",
    "blog:clear": "node blog-toolkit/blog-clear.mjs",
    "blog:images": "node blog-toolkit/seed-blog-images.mjs",
    "blog:seed": "node blog-toolkit/seed-blog.mjs",
    "blog:reseed": "node blog-toolkit/blog-clear.mjs && node blog-toolkit/seed-blog-images.mjs && node blog-toolkit/seed-blog.mjs",
    "seed:blog": "node blog-toolkit/seed-blog.mjs",
    "library:clear": "node library-toolkit/library-clear.mjs",
    "library:parse": "node library-toolkit/library-parse.mjs",
    "library:seed": "node library-toolkit/library-seed.mjs",
    "library:verify": "node library-toolkit/library-verify.mjs",
    "library:status": "node library-toolkit/library-status.mjs",
    "library:baseline": "node library-toolkit/library-baseline.mjs",
    "library:reseed": "node library-toolkit/library-reseed.mjs",
    "library:reseed:wipe": "node library-toolkit/library-reseed.mjs --wipe",
    "academy:status": "node academy-toolkit/academy-status.mjs",
    "academy:verify": "node academy-toolkit/academy-verify.mjs",
    "academy:seed": "node academy-toolkit/academy-seed.mjs",
    "docs:check-drift": "node scripts/check-docs-drift.mjs",
    "schema:check-drift": "node scripts/check-schema-manifest-drift.mjs",
    "contract:check-drift": "npx tsx scripts/check-frontmatter-contract-drift.ts",
    "library:check-repealed-active": "npx tsx scripts/check-repealed-shown-active.ts",
    "library:check-h16-h17-h18-gate": "npx tsx scripts/check-h16-h17-h18-gate.ts",
    "library:check-qadha-conventions": "npx tsx scripts/check-qadha-regulation-conventions.ts",
    "library:verify-contract": "node scripts/verify-seeder-contract.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@types/html2canvas": "^0.5.35",
    "@xyflow/react": "^12.10.2",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "^16.2.1",
    "react": "^19.0.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.1",
    "js-yaml": "^4.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
