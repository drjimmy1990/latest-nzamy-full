# =============================================================================
# NZAMY — Environment Variables
# =============================================================================
# HOW TO USE
#   1. Copy this file to `.env.local`      →   cp .env.example .env.local
#   2. Fill in the real values below.
#   3. NEVER commit `.env.local` — it holds secret keys and is gitignored.
#
# LEGEND
#   [REQUIRED]      the app will not work correctly without a real value.
#   [OPTIONAL]      feature-specific; safe to leave as-is until you need it.
#   NEXT_PUBLIC_*   exposed to the BROWSER (inlined into the JS bundle at build
#                   time). NEVER put a secret in a NEXT_PUBLIC_ variable.
#   (everything else)  server-only — never sent to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE  [REQUIRED]
# -----------------------------------------------------------------------------
# Get these from: Supabase dashboard -> Project Settings -> API.

# Public project URL (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key (browser-safe). Restricted by Row-Level Security (RLS),
# so it is safe to expose to the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — SERVER ONLY. This key BYPASSES Row-Level Security entirely.
# Never expose it to the browser, never log it, never commit it. Used only by
# admin routes and a few server-side writes that must skip RLS (e.g. payments
# inserts). Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# -----------------------------------------------------------------------------
# 2. BACKEND MODE  [REQUIRED — CRITICAL]
# -----------------------------------------------------------------------------
# Selects the real Supabase backend vs. a client-side demo. MUST be exactly
# "supabase" in every real / staging / production environment.
#
# WARNING: if this is unset (or anything other than "supabase"), the whole app
# silently falls back to CLIENT-SIDE DEMO ROLES — i.e. a full authentication
# bypass where anyone can select any role in the browser. The server startup
# check (src/instrumentation.ts) THROWS on boot in production if this is wrong,
# so a misconfigured deploy fails fast instead of shipping the demo.
NEXT_PUBLIC_NZAMY_WORKFLOW_BACKEND=supabase


# -----------------------------------------------------------------------------
# 3. APP CONFIGURATION
# -----------------------------------------------------------------------------
# Public base URL of this app — used for absolute links, redirects, OAuth
# callbacks, and email links. [REQUIRED]
# Local dev: http://localhost:3000   |   Prod: https://your-domain (e.g. https://nezamy.online)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment label for feature toggles / UI copy. [OPTIONAL]
# NOTE: this is NOT the security gate. The production env assertion keys off
# Node's own NODE_ENV (set automatically by `next build` / `next start`), not
# this value. Still, do not ship "development" to production — use "production".
NEXT_PUBLIC_APP_ENV=development

# Legal-library demo fallback. [OPTIONAL]
#   unset / "0"  (default, production): the library shows an honest EMPTY state
#                when the DB has no seeded rows, and smart-folders start empty —
#                no fabricated demo laws/folders are ever shown to real users.
#   "1"          (dev/preview only): render the built-in DEMO_* sample content.
NEXT_PUBLIC_LIB_DEMO_FALLBACK=0


# -----------------------------------------------------------------------------
# 4. n8n AUTOMATION  [OPTIONAL — the app runs fine without it]
# -----------------------------------------------------------------------------
# n8n drives welcome emails, WhatsApp, reminders, and verification flows.
# Outbound dispatch is INERT until N8N_WEBHOOK_BASE_URL is set, so leaving this
# section unset simply means "no automated notifications" — nothing breaks.
# (See n8n_master_guide_latest.md for the workflow build plan.)

# Base URL of your self-hosted n8n webhook endpoint. Leave unset to disable ALL
# outbound n8n calls.  Prod example: https://n8n.asra3.com/webhook
N8N_WEBHOOK_BASE_URL=http://your-n8n:5678/webhook

# Shared secret sent as the `X-Webhook-Secret` header on every OUTBOUND call to
# n8n (used by src/lib/n8n/dispatch.ts and the AI library-chat route). Leave
# unset in dev; in prod, set it AND verify it on the n8n side.
# WARNING: this only protects the app -> n8n direction. INBOUND webhooks
# (Supabase -> n8n, WhatsApp -> n8n) must have their OWN authentication
# configured on the n8n side.
N8N_WEBHOOK_SECRET=

# -- Per-workflow operational webhook URLs --------------------------------------
# Only needed if you address each workflow by its own full URL instead of
# composing paths from N8N_WEBHOOK_BASE_URL. Keep in sync with your n8n paths.
N8N_WEBHOOK_NEW_USER=http://your-n8n:5678/webhook/new-user
N8N_WEBHOOK_NEW_REQUEST=http://your-n8n:5678/webhook/new-request
N8N_WEBHOOK_REQUEST_ASSIGNED=http://your-n8n:5678/webhook/request-assigned
N8N_WEBHOOK_REQUEST_COMPLETED=http://your-n8n:5678/webhook/request-completed
N8N_WEBHOOK_PAYMENT=http://your-n8n:5678/webhook/payment
N8N_WEBHOOK_VERIFICATION=http://your-n8n:5678/webhook/verification
N8N_WEBHOOK_ESCALATION=http://your-n8n:5678/webhook/escalation
N8N_WEBHOOK_CONSULTATION_REMINDER=http://your-n8n:5678/webhook/consultation-reminder
N8N_WEBHOOK_HEARING_REMINDER=http://your-n8n:5678/webhook/hearing-reminder
N8N_WEBHOOK_WHATSAPP_TRIAGE=http://your-n8n:5678/webhook/whatsapp-triage

# -- AI tool webhooks (18 tools) ------------------------------------------------
# One endpoint per AI tool. Only needed once the corresponding n8n AI workflow
# is built; unset tools simply return a "coming soon" state in the UI.
N8N_WEBHOOK_AI_DRAFT=http://your-n8n:5678/webhook/ai/draft
N8N_WEBHOOK_AI_CONTRACTS=http://your-n8n:5678/webhook/ai/contracts
N8N_WEBHOOK_AI_CONTRACT_REVIEW=http://your-n8n:5678/webhook/ai/contract-review
N8N_WEBHOOK_AI_DIRECTION=http://your-n8n:5678/webhook/ai/direction-support
N8N_WEBHOOK_AI_WARGAMING=http://your-n8n:5678/webhook/ai/wargaming
N8N_WEBHOOK_AI_STRENGTH=http://your-n8n:5678/webhook/ai/analyze-strength
N8N_WEBHOOK_AI_SECRETARY=http://your-n8n:5678/webhook/ai/secretary
N8N_WEBHOOK_AI_RESEARCH=http://your-n8n:5678/webhook/ai/research
N8N_WEBHOOK_AI_QUICK_ANSWER=http://your-n8n:5678/webhook/ai/quick-answer
N8N_WEBHOOK_AI_TRANSLATE=http://your-n8n:5678/webhook/ai/translate
N8N_WEBHOOK_AI_CASE_BRIEF=http://your-n8n:5678/webhook/ai/case-brief
N8N_WEBHOOK_AI_FEE_CALC=http://your-n8n:5678/webhook/ai/fee-calculator
N8N_WEBHOOK_AI_LETTER=http://your-n8n:5678/webhook/ai/letter
N8N_WEBHOOK_AI_CASE_INSIGHT=http://your-n8n:5678/webhook/ai/case-insight
N8N_WEBHOOK_AI_CORP=http://your-n8n:5678/webhook/ai/corp
N8N_WEBHOOK_AI_GOV=http://your-n8n:5678/webhook/ai/gov
N8N_WEBHOOK_AI_MICRO=http://your-n8n:5678/webhook/ai/micro
N8N_WEBHOOK_AI_NGO=http://your-n8n:5678/webhook/ai/ngo


# -----------------------------------------------------------------------------
# 5. EVOLUTION API — WhatsApp (self-hosted)  [OPTIONAL]
# -----------------------------------------------------------------------------
# Only needed for the WhatsApp channel (inbound triage + outbound messages),
# which is driven through n8n. Leave unset to disable WhatsApp features.
EVOLUTION_API_URL=http://your-evolution-api:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=nzamy


# -----------------------------------------------------------------------------
# 6. PAYMENT GATEWAY  [OPTIONAL — disabled by default]
# -----------------------------------------------------------------------------
# Payments are gated OFF at runtime via the `platform_settings.payments_gateway`
# row (status: disabled | test | live), toggled from the admin panel — NOT via
# these env vars. Keep these commented until a provider is chosen
# (Moyasar / Tap / HyperPay), then wire the provider SDK and flip the admin flag.
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_SECRET_KEY=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# 7. AI / LLM PROVIDER KEYS  [NOT NEEDED HERE]
# -----------------------------------------------------------------------------
# The Next.js app does NOT call LLM providers directly. n8n holds all provider
# keys (OpenAI / Gemini / Claude) internally, so no LLM keys belong in this file.
