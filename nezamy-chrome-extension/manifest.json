{
  "manifest_version": 3,
  "name": "نظامي - جسر مزامنة ناجز الذكي",
  "version": "1.0.0",
  "description": "استيراد ومزامنة القضايا والجلسات والصكوك والوكالات من بوابة ناجز إلى منصة نظامي آلياً وبأمان تام.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/index.html",
    "default_title": "نظامي - مزامنة ناجز"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://najiz.sa/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://najiz.sa/*",
    "https://*.nezamy.sa/*",
    "http://localhost:3000/*"
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.nezamy.sa/*",
      "http://localhost:3000/*"
    ]
  }
}
