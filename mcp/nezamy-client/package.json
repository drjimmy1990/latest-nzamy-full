{
  "name": "@nezamy/client",
  "version": "0.1.0",
  "description": "Typed client for the Nezamy Lawyer API v1 (/api/v1/ext). Shared by the Nezamy MCP server and the Word add-in.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
