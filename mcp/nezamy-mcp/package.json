{
  "name": "nezamy-mcp",
  "version": "0.1.0",
  "description": "Nezamy MCP server: the Saudi legal library, graph, citation checker and AI drafting tools inside Claude (and any MCP client).",
  "type": "module",
  "files": ["dist"],
  "bin": {
    "nezamy-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start:stdio": "tsx src/index.ts stdio",
    "start:http": "tsx src/index.ts http",
    "mock": "tsx scripts/mock-platform.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@nezamy/client": "file:../nezamy-client",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true
}